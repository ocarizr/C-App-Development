file(MAKE_DIRECTORY "${WORK_DIR}/db data")
file(REMOVE "${WORK_DIR}/db data/team.db" "${WORK_DIR}/payroll.csv")
file(WRITE "${WORK_DIR}/app.yaml" "database:\n  path: 'db data/team.db'\n  busy_timeout_ms: 0\n")
file(WRITE "${WORK_DIR}/overlay.yaml" "database: {busy_timeout_ms: 100}\n")
function(session name content)
    file(WRITE "${WORK_DIR}/${name}.txt" "${content}")
    execute_process(COMMAND "${APP}" --config app.yaml --config overlay.yaml --script "${name}.txt"
        WORKING_DIRECTORY "${WORK_DIR}" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Session ${name} failed: ${result}\n${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
endfunction()
session(create "set worker.name=Ana Silva\nset worker.age=30\nset worker.profession=Developer\nset worker.department=Engineering\nset worker.level=Senior\nset worker.salary=3000\ninvoke worker.create\nset contract.year=2026\nset contract.month=10\nset contract.hours=10\nset contract.rate=25.50\ninvoke contract.add\nset salary.year=2026\nset salary.month=11\nset salary.amount=4000\ninvoke salary.save\nset worker.name=Ana Maria\ninvoke worker.save\nget worker.id\ntab contracts\nrender\nquit\n")
if(NOT output MATCHES "um novo foi criado" OR NOT output MATCHES "Ana Maria" OR NOT output MATCHES "25.50")
    message(FATAL_ERROR "Creation/UI failed: ${output}")
endif()
session(read "set worker.id=1\ninvoke worker.load\nget history\nget contracts\nset report.year=2026\nset report.month=10\ninvoke report.build\nget report\nset report.month=11\ninvoke report.build\nget report\nquit\n")
if(NOT output MATCHES "Conexao com o banco de dados realizada com sucesso" OR
   NOT output MATCHES "3255.00" OR NOT output MATCHES "4000.00" OR NOT output MATCHES "Ana Maria")
    message(FATAL_ERROR "Persistence/report regression: ${output}")
endif()
session(edit "set worker.id=1\ninvoke worker.load\nset contract.id=1\ninvoke contract.load\nset contract.hours=20\ninvoke contract.save\nset salary.year=2026\nset salary.month=11\nset salary.amount=4200\ninvoke salary.save\nset report.year=2026\nset report.month=10\nset report.department=Engineering\nset report.level=Senior\nset report.path=payroll.csv\ninvoke report.export\nget report\nreject report.export\nquit\n")
file(READ "${WORK_DIR}/payroll.csv" csv)
if(NOT output MATCHES "3510.00" OR NOT csv MATCHES "3510.00")
    message(FATAL_ERROR "Contract edit/export regression: ${output}\n${csv}")
endif()
session(correct "set worker.id=1\ninvoke worker.load\nget history\nset salary.year=2026\nset salary.month=11\ninvoke salary.delete\nset contract.id=1\ninvoke contract.delete\ninvoke worker.delete\nset worker.id=1\nreject worker.load\nget status\nquit\n")
if(NOT output MATCHES "4200.00" OR NOT output MATCHES "Registro nao encontrado")
    message(FATAL_ERROR "Correction/removal regression: ${output}")
endif()
session(absent "set worker.id=1\nreject worker.load\nget workers\nquit\n")
if(output MATCHES "Ana Maria")
    message(FATAL_ERROR "Removed employee reappeared: ${output}")
endif()
file(WRITE "${WORK_DIR}/bad.yaml" "database: {busy_timeout_ms: -1}\n")
execute_process(COMMAND "${APP}" --config bad.yaml --script absent.txt
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Erro de configuracao")
    message(FATAL_ERROR "Invalid config accepted: ${error}")
endif()
execute_process(COMMAND "${APP}" --ui missing.xml --script absent.txt
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Erro de UI")
    message(FATAL_ERROR "Missing XML accepted: ${error}")
endif()
file(REMOVE "${WORK_DIR}/db data/team.db" "${WORK_DIR}/payroll.csv")
